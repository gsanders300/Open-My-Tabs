{
  "manifest_version": 3,
  "name": "Open My Tabs",
  "version": "1.0.1",
  "description": "Opens your saved set of tabs with one click.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  }
}
